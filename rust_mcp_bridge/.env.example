# NVDA MCP Server (Rust) Configuration
# Copy this file to .env and update values

# NVDA Bridge server URL
NVDA_BRIDGE_URL=http://127.0.0.1:8765

# Authentication token for NVDA Bridge (required - use strong random value)
# Generate with any secure token generator (for example: 32+ random bytes, base64/url-safe)
NVDA_BRIDGE_TOKEN=change_me_to_secure_token

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
