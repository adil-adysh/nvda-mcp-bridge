  "tools": [
    {
      "name": "execute_python",
      "version": "1.0.0",
      "description": "Execute Python source inside NVDA and return console output/result.",
      "category": "developer",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "snapshot_vars": {
            "type": "boolean"
          },
          "capture_vars": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "code"
        ]
      },
      "outputType": "PythonExecutionResult",
      "constraints": {
        "blocked_on_secure_screen": true,
        "blocked_on_modal": true,
        "blocked_on_menu": true,
        "dangerous": true,
        "requires_explicit_opt_in": true,
        "requires_developer_mode": true
      },
      "readOnly": false,
      "destructive": true,
      "idempotent": false,
      "sideEffects": true,
      "requiredPermission": "developer",
      "cancellationSupported": false,
      "retrySafe": false
