{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.example/nvda_mcp_server",
  "description": "MCP server for interacting with NVDA via a local bridge for screen reader automation",
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "generic",
      "identifier": "nvda-mcp-server",
      "version": "1.0.0",
      "transport": {
        "type": "stdio",
        "command": "nvda-mcp-server.exe"
      },
      "environmentVariables": [
        {
          "name": "NVDA_BRIDGE_URL",
          "description": "URL of the NVDA bridge service",
          "isRequired": true,
          "format": "string"
        },
        {
          "name": "NVDA_BRIDGE_TOKEN",
          "description": "Authentication token for NVDA bridge",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "LOG_LEVEL",
          "description": "Logging level (e.g., INFO, DEBUG)",
          "isRequired": false,
          "format": "string"
        }
      ]
    }
  ]
}
