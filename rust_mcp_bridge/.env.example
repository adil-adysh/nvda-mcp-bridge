# NVDA MCP Server (Rust) Configuration
# Copy this file to .env and update values

# NVDA Bridge server URL
NVDA_BRIDGE_URL=http://127.0.0.1:8765

# Authentication token for NVDA Bridge (required - use strong random value)
# Generate with any secure token generator (for example: 32+ random bytes, base64/url-safe)
NVDA_BRIDGE_TOKEN=change_me_to_secure_token

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional: restrict the advertised catalog to these categories
# NVDA_BRIDGE_CATEGORIES=observation,focus

# Optional: advertise outputSchema in tools/list (off by default; roughly half
# of the catalog bytes). structuredContent is still validated when omitted.
# NVDA_BRIDGE_OUTPUT_SCHEMAS=1

# Optional: maximum tools per tools/list page (1-1000)
# NVDA_BRIDGE_TOOLS_PAGE_SIZE=100
