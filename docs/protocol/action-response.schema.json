{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvda.local/schemas/action-response.schema.json",
  "title": "NVDA Bridge Action Response",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "success",
    "action",
    "bridge",
    "nvda_status_snapshot"
  ],
  "properties": {
    "request_id": {
      "$ref": "common.schema.json#/$defs/uuidLike"
    },
    "success": {
      "type": "boolean"
    },
    "action": {
      "type": "string"
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "bridge": {
      "$ref": "common.schema.json#/$defs/bridgeMeta"
    },
    "nvda_status_snapshot": {
      "$ref": "common.schema.json#/$defs/nvdaStatusSnapshot"
    },
    "data": {},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "state_version": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "boolean"
        },
        "delta": {
          "type": "object"
        },
        "settled_ms": {
          "type": "number",
          "minimum": 0
        },
        "uncertain": {
          "type": "boolean"
        },
        "completed": {
          "type": "boolean"
        },
        "expect_mismatch": {
          "type": "object"
        },
        "projection_available": {
          "type": "boolean"
        },
        "observed": {
          "type": "boolean"
        },
        "events_complete": {
          "type": "boolean"
        },
        "settling_status": {
          "type": "string",
          "enum": [
            "settled",
            "budget_expired",
            "unavailable",
            "cancelled"
          ]
        },
        "budget_expired": {
          "type": "boolean"
        },
        "verification": {
          "type": "string",
          "enum": [
            "confirmed",
            "contradicted",
            "unavailable"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object"
          }
        },
        "cancelled": {
          "type": "boolean"
        },
        "scope": {
          "type": "object"
        }
      }
    },
    "error": {
      "$ref": "common.schema.json#/$defs/actionError"
    }
  }
}
